pipeline {

    agent any

    tools {
        nodejs 'nodejs'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git(
                    branch: 'main',
                    url: 'https://github.com/iampratik11/Argocd_Kubernetes_DevSecops.git'
                )
            }
        }

        stage('Sonarqube Analysis') {
            steps {

                dir('Tetris-V1') {

                    withSonarQubeEnv('sonar-scanner') {

                        sh '''
                            echo "========================================"
                            echo "Running SonarQube Analysis"
                            echo "========================================"

                            $SCANNER_HOME/bin/sonar-scanner \
                                -Dsonar.projectName=Tetris \
                                -Dsonar.projectKey=Tetris

                            echo "SonarQube analysis completed."
                        '''
                    }
                }
            }
        }

        stage('Quality Check') {
            steps {

                script {

                    waitForQualityGate(
                        abortPipeline: false,
                        credentialsId: 'sonar-token'
                    )
                }
            }
        }

        stage('Installing Dependencies') {
            steps {

                dir('Tetris-V1') {

                    sh '''
                        echo "========================================"
                        echo "Node version:"
                        node --version

                        echo "NPM version:"
                        npm --version
                        echo "========================================"

                        npm install

                        echo "NPM dependencies installed successfully."
                    '''
                }
            }
        }

        stage('Trivy File Scan') {
            steps {

                dir('Tetris-V1') {

                    sh '''
                        echo "========================================"
                        echo "Running Trivy filesystem scan..."
                        echo "========================================"

                        trivy fs . > trivyfs.txt

                        echo "Trivy filesystem scan completed."
                    '''
                }
            }
        }

        stage('Docker Image Build') {
            steps {

                dir('Tetris-V1') {

                    sh '''
                        echo "========================================"
                        echo "Docker executable:"
                        which docker

                        echo "Docker version:"
                        docker --version

                        echo "========================================"
                        echo "Building Docker image..."
                        echo "========================================"

                        docker build \
                            -t tetrisv1 .

                        echo "Docker image built successfully."

                        echo "========================================"
                        echo "Docker images:"
                        echo "========================================"

                        docker images | grep tetrisv1 || true
                    '''
                }
            }
        }

        stage('Docker Image Pushing') {
            steps {

                script {

                    withDockerRegistry(
                        credentialsId: 'docker'
                    ) {

                        sh '''
                            echo "========================================"
                            echo "Docker executable:"
                            which docker

                            echo "Docker version:"
                            docker --version

                            echo "========================================"
                            echo "Tagging Docker image..."
                            echo "========================================"

                            docker tag \
                                tetrisv1 \
                                pratikwagh99/tetrisv1:${BUILD_NUMBER}

                            echo "========================================"
                            echo "Pushing Docker image..."
                            echo "========================================"

                            docker push \
                                pratikwagh99/tetrisv1:${BUILD_NUMBER}

                            echo "========================================"
                            echo "Docker image pushed successfully."
                            echo "========================================"

                            echo "Image:"
                            echo "pratikwagh99/tetrisv1:${BUILD_NUMBER}"
                        '''
                    }
                }
            }
        }

        stage('TRIVY Image Scan') {
            steps {

                sh '''
                    echo "========================================"
                    echo "Running Trivy image scan..."
                    echo "========================================"

                    trivy image \
                        pratikwagh99/tetrisv1:${BUILD_NUMBER} \
                        > Tetris-V1/trivyimage.txt

                    echo "Trivy image scan completed."
                '''
            }
        }

        stage('Checkout Manifest Repository') {
            steps {

                dir('Manifest-file') {

                    deleteDir()

                    git(
                        branch: 'main',
                        url: 'https://github.com/iampratik11/Argocd_Kubernetes_DevSecops.git'
                    )
                }
            }
        }

        stage('Update Deployment File') {

            environment {
                GIT_REPO_NAME = 'Argocd_Kubernetes_DevSecops'
                GIT_USER_NAME = 'iampratik11'
            }

            steps {

                dir('Manifest-file') {

                    withCredentials([
                        string(
                            credentialsId: 'github',
                            variable: 'GITHUB_TOKEN'
                        )
                    ]) {

                        sh '''
                            set -e

                            echo "========================================"
                            echo "Updating Kubernetes Deployment"
                            echo "========================================"

                            echo "Current directory:"
                            pwd

                            echo "========================================"
                            echo "Repository Structure"
                            echo "========================================"

                            ls -la

                            echo "========================================"
                            echo "Checking Manifest File"
                            echo "========================================"

                            DEPLOYMENT_FILE="Manifest-file/deployment-service.yml"

                            if [ ! -f "$DEPLOYMENT_FILE" ]; then
                                echo "ERROR: Deployment file not found:"
                                echo "$DEPLOYMENT_FILE"
                                exit 1
                            fi

                            echo "Deployment file found:"
                            echo "$DEPLOYMENT_FILE"

                            echo "========================================"
                            echo "Current Image"
                            echo "========================================"

                            grep -n "image:" "$DEPLOYMENT_FILE" || true

                            echo "========================================"
                            echo "Build Information"
                            echo "========================================"

                            echo "Build Number:"
                            echo "${BUILD_NUMBER}"

                            echo "New Docker Image:"
                            echo "pratikwagh99/tetrisv1:${BUILD_NUMBER}"

                            echo "========================================"
                            echo "Git Configuration"
                            echo "========================================"

                            git config user.email "waghpratik777@gmail.com"
                            git config user.name "iampratik11"

                            echo "========================================"
                            echo "Updating Kubernetes Image"
                            echo "========================================"

                            sed -i \
                                -E "s|(image:.*pratikwagh99/tetrisv1:)[^[:space:]]+|\\1${BUILD_NUMBER}|" \
                                "$DEPLOYMENT_FILE"

                            echo "========================================"
                            echo "Updated Image"
                            echo "========================================"

                            grep -n "image:" "$DEPLOYMENT_FILE"

                            echo "========================================"
                            echo "Git Status"
                            echo "========================================"

                            git status

                            echo "========================================"
                            echo "Adding Deployment File"
                            echo "========================================"

                            git add "$DEPLOYMENT_FILE"

                            if git diff --cached --quiet; then

                                echo "No changes detected."

                            else

                                echo "========================================"
                                echo "Creating Git Commit"
                                echo "========================================"

                                git commit \
                                    -m "Update deployment Image to version ${BUILD_NUMBER}"

                                echo "========================================"
                                echo "Pushing Changes to GitHub"
                                echo "========================================"

                                git push \
                                    https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                                    HEAD:main

                                echo "========================================"
                                echo "Manifest repository updated successfully."
                                echo "========================================"

                            fi
                        '''
                    }
                }
            }
        }
    }

    post {

        always {

            echo '========================================'
            echo 'Pipeline completed'
            echo '========================================'

            archiveArtifacts(
                artifacts: 'Tetris-V1/trivyfs.txt,Tetris-V1/trivyimage.txt',
                allowEmptyArchive: true
            )
        }

        success {

            echo '========================================'
            echo 'PIPELINE SUCCESS'
            echo '========================================'
        }

        failure {

            echo '========================================'
            echo 'PIPELINE FAILED'
            echo 'Check the failed stage above.'
            echo '========================================'
        }
    }
}
